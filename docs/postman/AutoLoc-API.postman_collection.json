  "item": [
    {
      "name": "Agence",
      "item": [
        {
          "name": "Créer une agence",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('idAgence', pm.response.json().idAgence);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/agences",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"AutoLoc Centre\",\n  \"ville\": \"Tunis\",\n  \"adresse\": \"12 Av. Habib Bourguiba\",\n  \"telephone\": \"71000000\"\n}"
            }
          }
        },
        {
          "name": "Lister les agences",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Tableau JSON', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/agences"
          }
        },
        {
          "name": "Consulter une agence",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Bon identifiant', () => pm.expect(pm.response.json().idAgence).to.eql(Number(pm.collectionVariables.get('idAgence'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/agences/{{idAgence}}"
          }
        },
        {
          "name": "Modifier une agence",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/agences/{{idAgence}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"AutoLoc Lac\",\n  \"ville\": \"Tunis\",\n  \"adresse\": \"Rue du Lac Biwa\",\n  \"telephone\": \"71111111\"\n}"
            }
          }
        },
        {
          "name": "Créer une agence invalide (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/agences",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"\",\n  \"ville\": \"Sfax\",\n  \"adresse\": \"Route de Tunis\"\n}"
            }
          }
        },
        {
          "name": "Supprimer une agence",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/agences/{{idAgence}}"
          }
        },
        {
          "name": "Consulter une agence supprimée (404)",
